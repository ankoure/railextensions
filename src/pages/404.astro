---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <p class="text-6xl font-bold text-gray-200 mb-4">404</p>
    <h1 class="text-2xl font-semibold text-gray-800 mb-2">Page not found</h1>
    <p class="text-gray-500 mb-8">That page doesn't exist or has been moved.</p>
    <a href="/" class="text-blue-700 hover:underline font-medium">← Back to all projects</a>
  </div>
</BaseLayout>
