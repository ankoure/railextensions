---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = await getCollection('projects');

function agencySlug(p: (typeof projects)[number]): string {
  return (p.data.agencyAbbr ?? p.data.agency).toLowerCase().replace(/\s+/g, '-');
}

const mapProjects = projects
  .filter(p => p.data.coordinates)
  .map(p => ({
    id: p.id,
    projectName: p.data.projectName,
    agency: p.data.agencyAbbr ?? p.data.agency,
    agencySlug: agencySlug(p),
    state: p.data.state,
    status: p.data.status ?? null,
    coordinates: p.data.coordinates,
    hasGeometry: p.data.hasGeometry ?? false,
  }));

const skipped = projects.length - mapProjects.length;
---

<BaseLayout title="Map" description="Explore all tracked rail extension projects on one map.">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 mb-1">Project Map</h1>
    <p class="text-gray-500 text-sm">
      {mapProjects.length} project{mapProjects.length !== 1 ? 's' : ''} plotted. Click a marker or alignment to open its project page.
      {skipped > 0 && ` ${skipped} project${skipped !== 1 ? 's' : ''} without coordinates not shown.`}
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <div class="lg:col-span-3">
      <div id="overview-map" data-projects={JSON.stringify(mapProjects)} class="w-full h-[32rem] rounded-lg border border-gray-200 shadow-sm bg-gray-100"></div>
      <p class="text-xs text-gray-400 mt-1">Alignments are approximate.</p>
    </div>

    <aside class="lg:col-span-1">
      <div class="rounded-lg border border-gray-200 bg-white p-4 text-sm shadow-sm">
        <h2 class="font-semibold text-gray-800 text-base mb-3">Status</h2>
        <ul class="space-y-2" id="map-legend"></ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  import type { Layer } from 'leaflet';
  import {
    DEFAULT_LINE_COLOR, L, alignmentLayer, createMap, escapeHtml, fetchGeometry, stationMarker,
  } from '../lib/map';

  interface MapProject {
    id: string;
    projectName: string;
    agency: string;
    agencySlug: string;
    state: string;
    status: string | null;
    coordinates: { lat: number; lng: number };
    hasGeometry: boolean;
  }

  const STATUS_COLORS: Record<string, string> = {
    'proposed': '#6b7280',
    'planning': '#2563eb',
    'environmental-review': '#9333ea',
    'funded': '#0d9488',
    'under-construction': '#ca8a04',
    'on-hold': '#ea580c',
    'completed': '#16a34a',
    'cancelled': '#dc2626',
  };
  const STATUS_LABELS: Record<string, string> = {
    'proposed': 'Proposed',
    'planning': 'Planning',
    'environmental-review': 'Env. Review',
    'funded': 'Funded',
    'under-construction': 'Under Construction',
    'on-hold': 'On Hold',
    'completed': 'Completed',
    'cancelled': 'Cancelled',
  };

  function colorFor(status: string | null): string {
    return (status && STATUS_COLORS[status]) || DEFAULT_LINE_COLOR;
  }

  const el = document.getElementById('overview-map');
  const mapProjects: MapProject[] = JSON.parse(el?.dataset.projects ?? '[]');

  const legendEl = document.getElementById('map-legend')!;
  function addLegendItem(color: string, label: string) {
    const li = document.createElement('li');
    li.className = 'flex items-center gap-2';
    li.innerHTML = `<span class="inline-block w-3 h-3 rounded-full shrink-0" style="background:${color}"></span><span class="text-gray-600 text-xs">${label}</span>`;
    legendEl.appendChild(li);
  }
  const usedStatuses = new Set(mapProjects.map(p => p.status).filter(Boolean));
  Object.keys(STATUS_LABELS)
    .filter(s => usedStatuses.has(s))
    .forEach(status => addLegendItem(colorFor(status), STATUS_LABELS[status]));
  if (mapProjects.some(p => !p.status)) addLegendItem(DEFAULT_LINE_COLOR, 'Unspecified');

  if (el) {
    const map = createMap(el, { scrollWheelZoom: true });
    const allLayers: Layer[] = [];

    function refitBounds() {
      try { map.fitBounds(L.featureGroup(allLayers).getBounds().pad(0.1)); } catch {}
    }

    function popupHtml(p: MapProject): string {
      return `
        <div style="font-size:13px;min-width:180px">
          <div style="font-weight:600;margin-bottom:2px">${escapeHtml(p.projectName)}</div>
          <div style="color:#6b7280;margin-bottom:6px">${escapeHtml(p.agency)} &middot; ${escapeHtml(p.state)}</div>
          <a href="/projects/${escapeHtml(p.id)}" style="color:#1d4ed8;font-weight:600;text-decoration:none">View project &rarr;</a>
        </div>
      `;
    }

    function addFallbackMarker(p: MapProject) {
      const marker = stationMarker([p.coordinates.lat, p.coordinates.lng], {
        color: colorFor(p.status), radius: 8, weight: 2, fillOpacity: 0.9,
      }).addTo(map).bindPopup(popupHtml(p));
      allLayers.push(marker);
    }

    mapProjects.forEach(async p => {
      if (!p.hasGeometry) {
        addFallbackMarker(p);
        return;
      }
      try {
        const layer = alignmentLayer(await fetchGeometry(p.id), {
          color: colorFor(p.status), lineWeight: 4, stationRadius: 5, stationWeight: 1.5,
        }).bindPopup(popupHtml(p)).addTo(map);
        allLayers.push(layer);
      } catch {
        addFallbackMarker(p);
      }
      refitBounds();
    });

    setTimeout(refitBounds, 300);
  }
</script>
