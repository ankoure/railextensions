---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { MODES, modeLabel } from '../lib/modes';
import StatusBadge from '../components/StatusBadge.astro';
import { COUNTRY_NAMES, COUNTRY_ORDER, regionCountry, regionName } from '../lib/regions';

const allProjects = await getCollection('projects');

// Sort: lastUpdated desc, nulls last
const projects = allProjects.sort((a, b) => {
  const da = a.data.lastUpdated?.getTime() ?? 0;
  const db = b.data.lastUpdated?.getTime() ?? 0;
  return db - da;
});

// Unique filter options
const regionGroups = COUNTRY_ORDER
  .map(country => ({
    country,
    label: COUNTRY_NAMES[country],
    regions: [...new Set(projects.map(p => p.data.state))]
      .filter(code => regionCountry(code) === country)
      .sort((a, b) => regionName(a).localeCompare(regionName(b))),
  }))
  .filter(g => g.regions.length > 0);
const agencies = [...new Set(projects.map(p => p.data.agencyAbbr ?? p.data.agency))].sort();
const modes = MODES.filter(m => projects.some(p => p.data.mode === m));
const statuses = [...new Set(projects.map(p => p.data.status).filter(Boolean))].sort() as string[];

function agencySlug(p: typeof projects[0]): string {
  return (p.data.agencyAbbr ?? p.data.agency).toLowerCase().replace(/\s+/g, '-');
}

function formatDate(d?: Date): string {
  if (!d) return '—';
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<BaseLayout title="All Projects">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 mb-1">Rail Extension Tracker</h1>
    <p class="text-gray-500 text-sm">
      {projects.length} project{projects.length !== 1 ? 's' : ''} tracked. Filter by country, region, agency, mode, or status, or search by name.
    </p>
  </div>

  <!-- Filters -->
  <div class="flex flex-wrap gap-3 mb-6" id="filters">
    <input
      id="filter-search"
      type="search"
      placeholder="Search projects…"
      aria-label="Search by project name, agency, or alignment"
      class="text-sm border border-gray-300 rounded px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400 w-full sm:w-64"
    />

    <select id="filter-country" class="text-sm border border-gray-300 rounded px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400">
      <option value="">All Countries</option>
      {regionGroups.map(g => <option value={g.country}>{g.label}</option>)}
    </select>

    <select id="filter-state" class="text-sm border border-gray-300 rounded px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400">
      <option value="">All Regions</option>
      {regionGroups.map(g => (
        <optgroup label={g.label}>
          {g.regions.map(code => <option value={code}>{regionName(code)} ({code})</option>)}
        </optgroup>
      ))}
    </select>

    <select id="filter-agency" class="text-sm border border-gray-300 rounded px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400">
      <option value="">All Agencies</option>
      {agencies.map(a => <option value={a}>{a}</option>)}
    </select>

    <select id="filter-mode" class="text-sm border border-gray-300 rounded px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400">
      <option value="">All Modes</option>
      {modes.map(m => <option value={m}>{modeLabel(m)}</option>)}
    </select>

    <select id="filter-status" class="text-sm border border-gray-300 rounded px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400">
      <option value="">All Statuses</option>
      {statuses.map(s => <option value={s}>{s}</option>)}
    </select>

    <button id="clear-filters" class="text-sm text-blue-600 hover:underline px-2">Clear filters</button>

    <span id="filter-count" class="text-sm text-gray-400 self-center"></span>
  </div>

  <!-- Table -->
  <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
    <table class="w-full text-sm text-left">
      <thead class="bg-gray-100 text-gray-600 text-xs uppercase tracking-wide">
        <tr>
          <th class="px-4 py-3 font-semibold">Project</th>
          <th class="px-4 py-3 font-semibold">Agency</th>
          <th class="px-4 py-3 font-semibold">Region</th>
          <th class="px-4 py-3 font-semibold">Mode</th>
          <th class="px-4 py-3 font-semibold">Status</th>
          <th class="px-4 py-3 font-semibold">Alignment</th>
          <th class="px-4 py-3 font-semibold whitespace-nowrap">Last Updated</th>
        </tr>
      </thead>
      <tbody id="project-table-body" class="divide-y divide-gray-100">
        {projects.map(p => (
          <tr
            class="bg-white hover:bg-blue-50 transition-colors"
            data-country={regionCountry(p.data.state)}
            data-state={p.data.state}
            data-agency={p.data.agencyAbbr ?? p.data.agency}
            data-mode={p.data.mode ?? ''}
            data-status={p.data.status ?? ''}
            data-search={[p.data.projectName, p.data.agency, p.data.agencyAbbr, p.data.alignmentSummary]
              .filter(Boolean).join(' ').normalize('NFD').replace(/\p{M}/gu, '').toLowerCase()}
          >
            <td class="px-4 py-3 font-medium">
              <a href={`/projects/${p.id}`} class="text-blue-700 hover:underline">
                {p.data.projectName}
              </a>
            </td>
            <td class="px-4 py-3 text-gray-700">
              <a href={`/agencies/${agencySlug(p)}`} class="hover:underline">
                {p.data.agencyAbbr ?? p.data.agency}
              </a>
            </td>
            <td class="px-4 py-3">
              <a href={`/states/${p.data.state}`} title={regionName(p.data.state)} class="font-medium text-blue-600 hover:underline">
                {p.data.state}
              </a>
            </td>
            <td class="px-4 py-3 text-gray-600">{modeLabel(p.data.mode) ?? '—'}</td>
            <td class="px-4 py-3">
              <StatusBadge status={p.data.status} />
            </td>
            <td class="px-4 py-3 text-gray-600 max-w-xs">{p.data.alignmentSummary}</td>
            <td class="px-4 py-3 text-gray-500 whitespace-nowrap">{formatDate(p.data.lastUpdated)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p id="no-results" class="hidden text-center text-gray-500 py-12">No projects match the selected filters.</p>
</BaseLayout>

<script>
  const countryEl = document.getElementById('filter-country') as HTMLSelectElement;
  const stateEl = document.getElementById('filter-state') as HTMLSelectElement;
  const agencyEl = document.getElementById('filter-agency') as HTMLSelectElement;
  const modeEl = document.getElementById('filter-mode') as HTMLSelectElement;
  const statusEl = document.getElementById('filter-status') as HTMLSelectElement;
  const searchEl = document.getElementById('filter-search') as HTMLInputElement;
  const clearBtn = document.getElementById('clear-filters') as HTMLButtonElement;
  const countEl = document.getElementById('filter-count') as HTMLSpanElement;
  const noResults = document.getElementById('no-results') as HTMLParagraphElement;
  const rows = document.querySelectorAll<HTMLTableRowElement>('#project-table-body tr');

  function applyFilters() {
    const country = countryEl.value;
    const state = stateEl.value;
    const agency = agencyEl.value;
    const mode = modeEl.value;
    const status = statusEl.value;
    const terms = searchEl.value.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().split(/\s+/).filter(Boolean);
    let visible = 0;

    rows.forEach(row => {
      const match =
        (!country || row.dataset.country === country) &&
        (!state  || row.dataset.state  === state)  &&
        (!agency || row.dataset.agency === agency)  &&
        (!mode   || row.dataset.mode   === mode)    &&
        (!status || row.dataset.status === status)  &&
        terms.every(t => row.dataset.search?.includes(t));

      row.classList.toggle('hidden', !match);
      if (match) visible++;
    });

    countEl.textContent = country || state || agency || mode || status || terms.length
      ? `${visible} of ${rows.length} shown`
      : '';
    noResults.classList.toggle('hidden', visible > 0);
  }

  countryEl.addEventListener('change', applyFilters);
  stateEl.addEventListener('change', applyFilters);
  agencyEl.addEventListener('change', applyFilters);
  modeEl.addEventListener('change', applyFilters);
  statusEl.addEventListener('change', applyFilters);
  searchEl.addEventListener('input', applyFilters);

  clearBtn.addEventListener('click', () => {
    countryEl.value = '';
    stateEl.value = '';
    agencyEl.value = '';
    modeEl.value = '';
    statusEl.value = '';
    searchEl.value = '';
    applyFilters();
  });
</script>
