---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import MapView from '../../components/MapView.astro';
import { COUNTRY_NAMES, regionCountry, regionName } from '../../lib/regions';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

function agencySlug(): string {
  return (d.agencyAbbr ?? d.agency).toLowerCase().replace(/\s+/g, '-');
}

function formatDate(date?: Date): string {
  if (!date) return '—';
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title={d.projectName} description={d.alignmentSummary}>
  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 mb-6 flex gap-1.5 items-center">
    <a href="/" class="hover:text-blue-700">All Projects</a>
    <span>/</span>
    <span class="text-gray-900">{d.projectName}</span>
  </nav>

  <!-- Header -->
  <div class="mb-8">
    <div class="flex flex-wrap items-start gap-3 mb-2">
      <h1 class="text-2xl font-bold text-gray-900">{d.projectName}</h1>
      <StatusBadge status={d.status} />
    </div>
    <p class="text-gray-600">{d.alignmentSummary}</p>
  </div>

  <!-- Alignment map (full-width, only when geometry file exists) -->
  {d.hasGeometry && (
    <MapView entryId={entry.id} coordinates={d.coordinates} />
  )}

  <!-- Two-column layout: info card + body -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- Info card -->
    <aside class="lg:col-span-1">
      <div class="rounded-lg border border-gray-200 bg-white p-5 text-sm space-y-3 shadow-sm">
        <h2 class="font-semibold text-gray-800 text-base mb-1">Project Details</h2>

        <div class="flex flex-col gap-0.5">
          <span class="text-xs text-gray-400 uppercase tracking-wide">Agency</span>
          <a href={`/agencies/${agencySlug()}`} class="text-blue-700 hover:underline font-medium">
            {d.agency}{d.agencyAbbr ? ` (${d.agencyAbbr})` : ''}
          </a>
        </div>

        <div class="flex flex-col gap-0.5">
          <span class="text-xs text-gray-400 uppercase tracking-wide">Region</span>
          <span>
            <a href={`/states/${d.state}`} class="text-blue-700 hover:underline font-medium">{regionName(d.state)}</a><span class="text-gray-500">, {COUNTRY_NAMES[regionCountry(d.state)]}</span>
          </span>
        </div>

        {d.location && (
          <div class="flex flex-col gap-0.5">
            <span class="text-xs text-gray-400 uppercase tracking-wide">Location</span>
            <span class="text-gray-700">{d.location}</span>
          </div>
        )}

        {d.mode && (
          <div class="flex flex-col gap-0.5">
            <span class="text-xs text-gray-400 uppercase tracking-wide">Mode</span>
            <span class="text-gray-700 capitalize">{d.mode.replace(/-/g, ' ')}</span>
          </div>
        )}

        {d.lengthMiles !== undefined && (
          <div class="flex flex-col gap-0.5">
            <span class="text-xs text-gray-400 uppercase tracking-wide">Length</span>
            <span class="text-gray-700">{d.lengthMiles} miles</span>
          </div>
        )}

        {d.estimatedCost && (
          <div class="flex flex-col gap-0.5">
            <span class="text-xs text-gray-400 uppercase tracking-wide">Estimated Cost</span>
            <span class="text-gray-700">{d.estimatedCost}</span>
          </div>
        )}

        {d.proposedOpening && (
          <div class="flex flex-col gap-0.5">
            <span class="text-xs text-gray-400 uppercase tracking-wide">Proposed Opening</span>
            <span class="text-gray-700">{d.proposedOpening}</span>
          </div>
        )}

        {d.coordinates && (
          <div class="flex flex-col gap-0.5">
            <span class="text-xs text-gray-400 uppercase tracking-wide">Coordinates</span>
            <span class="text-gray-700 font-mono text-xs">{d.coordinates.lat}, {d.coordinates.lng}</span>
          </div>
        )}

        {d.lastUpdated && (
          <div class="flex flex-col gap-0.5 pt-2 border-t border-gray-100">
            <span class="text-xs text-gray-400 uppercase tracking-wide">Last Updated</span>
            <span class="text-gray-500 text-xs">{formatDate(d.lastUpdated)}</span>
          </div>
        )}
      </div>
    </aside>

    <!-- Main content -->
    <div class="lg:col-span-2 space-y-10">
      <!-- Markdown body -->
      <div class="prose prose-gray max-w-none">
        <Content />
      </div>

      <!-- References -->
      {d.references.length > 0 && (
        <section>
          <h2 class="text-lg font-semibold text-gray-800 mb-3">References</h2>
          <ReferenceList references={d.references} />
        </section>
      )}
    </div>
  </div>
</BaseLayout>
