---
interface Props {
  entryId: string;
  coordinates?: { lat: number; lng: number };
}

const { entryId, coordinates } = Astro.props;
---

<section class="mb-8">
  <h2 class="text-lg font-semibold text-gray-800 mb-3">Alignment Map</h2>
  <div
    data-map-view
    data-entry-id={entryId}
    data-coordinates={coordinates ? JSON.stringify(coordinates) : undefined}
    class="w-full h-80 rounded-lg border border-gray-200 shadow-sm bg-gray-100"
  ></div>
  <p class="text-xs text-gray-400 mt-1">Alignment is approximate.</p>
</section>

<script>
  import { alignmentLayer, createMap, escapeHtml, fetchGeometry, stationMarker } from '../lib/map';

  document.querySelectorAll<HTMLElement>('[data-map-view]').forEach(async el => {
    const entryId = el.dataset.entryId!;
    const coordinates: { lat: number; lng: number } | undefined =
      el.dataset.coordinates ? JSON.parse(el.dataset.coordinates) : undefined;

    const map = createMap(el, coordinates
      ? { center: [coordinates.lat, coordinates.lng], zoom: 12 }
      : {});

    try {
      const layer = alignmentLayer(await fetchGeometry(entryId), {
        onEachFeature: (feat, layer) => {
          const name = feat.properties?.name;
          if (name) {
            layer.bindPopup(`<span style="font-size:13px;font-weight:600">${escapeHtml(String(name))}</span>`);
          }
        },
      }).addTo(map);
      try { map.fitBounds(layer.getBounds().pad(0.15)); } catch {}
    } catch {
      if (coordinates) {
        stationMarker([coordinates.lat, coordinates.lng], { radius: 9 }).addTo(map);
      }
    }
  });
</script>
