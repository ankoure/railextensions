---
interface Props {
  status?: string;
}

const { status } = Astro.props;

const colorMap: Record<string, string> = {
  'proposed':             'bg-gray-100 text-gray-700',
  'planning':             'bg-blue-100 text-blue-700',
  'environmental-review': 'bg-purple-100 text-purple-700',
  'funded':               'bg-teal-100 text-teal-700',
  'under-construction':   'bg-yellow-100 text-yellow-800',
  'on-hold':              'bg-orange-100 text-orange-700',
  'completed':            'bg-green-100 text-green-700',
  'cancelled':            'bg-red-100 text-red-700',
};

const label: Record<string, string> = {
  'proposed':             'Proposed',
  'planning':             'Planning',
  'environmental-review': 'Env. Review',
  'funded':               'Funded',
  'under-construction':   'Under Construction',
  'on-hold':              'On Hold',
  'completed':            'Completed',
  'cancelled':            'Cancelled',
};

const cls = status ? (colorMap[status] ?? 'bg-gray-100 text-gray-600') : '';
const text = status ? (label[status] ?? status) : '—';
---

{status
  ? <span class={`inline-block px-2 py-0.5 rounded text-xs font-medium ${cls}`}>{text}</span>
  : <span class="text-gray-400 text-xs">—</span>
}
